# Copie este archivo como .environments/application-secrets.properties.
# Es OPCIONAL: la app lo carga al arrancar si existe (spring.config.import) y
# sus valores tienen prioridad sobre el .env para desarrollo local.
# Reemplace todos los valores de ejemplo. Nunca versionar el archivo real.

# ---- Base de datos local ----
db.host=localhost
db.port=3306
db.name=crud_usuarios
db.username=users_app
db.password=REEMPLAZAR

# ---- JWT: Base64 de al menos 32 bytes aleatorios ----
# Genere una con: openssl rand -base64 48
jwt.secret=REEMPLAZAR

# ---- Brevo local ----
# Estas claves tienen prioridad sobre BREVO_API_KEY / BREVO_FROM_* cuando se
# usa este archivo en desarrollo local (la config usa brevo.local.* antes que brevo.*).
brevo.local.api-key=xkeysib-REEMPLAZAR
brevo.local.from.address=remitente-verificado@example.com
brevo.local.from.name=Gestion de Usuarios