# Copie este archivo como .env y complete los valores reales. NUNCA suba el .env.
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=su_clave_de_mysql
DB_SSL_MODE=DISABLED

# Clave generada en https://myaccount.google.com/apppasswords (sin espacios)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=su_correo@gmail.com
SMTP_PASSWORD=clave_de_aplicacion
SMTP_FROM_ADDRESS=su_correo@gmail.com
SMTP_FROM_NAME=Gestion de Usuarios

JWT_EXPIRATION_SECONDS=900

# Supabase (Session pooler): DB_ENGINE=postgresql, DB_HOST=aws-0-<region>.pooler.supabase.com,
#   DB_PORT=5432, DB_NAME=postgres, DB_USERNAME=postgres.<project-ref>, DB_SSL_MODE=require