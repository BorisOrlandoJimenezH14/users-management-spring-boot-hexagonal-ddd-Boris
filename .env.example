# Copie este archivo como .env y complete los valores reales. NUNCA suba el .env.
# Lo usan tanto Docker Compose (compose.yaml) como la app en local
# (spring.config.import en application.properties).

# ---- Base de datos local (MySQL 8.4 via Docker Compose) ----
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crud_usuarios
# Usuario que crea compose.yaml (MYSQL_USER). Tambien puede usarse root.
DB_USERNAME=users_app
DB_PASSWORD=REEMPLAZAR
DB_SSL_MODE=DISABLED
# Solo la usa compose.yaml para el contenedor MySQL.
MYSQL_ROOT_PASSWORD=REEMPLAZAR

# ---- JWT ----
# Genere una con: openssl rand -base64 48  (al menos 32 bytes codificados en Base64).
# La app NO arranca si esta vacia.
JWT_SECRET=REEMPLAZAR_CON_BASE64_DE_32_BYTES
JWT_EXPIRATION_SECONDS=900

# ---- Brevo (envio de correos transaccionales) ----
# Api key desde https://app.brevo.com/settings/keys/apikeys
BREVO_API_KEY=xkeysib-REEMPLAZAR
# Remitente verificado en Brevo
BREVO_FROM_ADDRESS=remitente-verificado@example.com
BREVO_FROM_NAME=Gestion de Usuarios

# Opcionales (con valores por defecto en application.properties):
#   BREVO_BASE_URL, BREVO_CONNECT_TIMEOUT, BREVO_READ_TIMEOUT,
#   BREVO_RETRY_MAX_ATTEMPTS, BREVO_RETRY_INITIAL_DELAY, BREVO_RETRY_MULTIPLIER,
#   BREVO_CIRCUIT_FAILURE_THRESHOLD, BREVO_CIRCUIT_WINDOW_SIZE,
#   BREVO_CIRCUIT_MINIMUM_CALLS, BREVO_CIRCUIT_OPEN_DURATION

# TiDB Cloud Serverless (compatible con MySQL): DB_ENGINE=mysql,
#   DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com, DB_PORT=4000,
#   DB_USERNAME=<prefijo>.root, DB_SSL_MODE=REQUIRED